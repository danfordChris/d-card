# ─────────────────────────────────────────────────────────────────────────────
# D-Card environment configuration
#
#   cp .env.example .env      # then replace every value starting with "dummy_"
#   pnpm env:check            # shows which providers are ready / still dummy
#
# Rules
#   • Never commit .env (it is gitignored). Commit only this file.
#   • Values starting with "dummy_" are placeholders; features using them stay off.
#   • Production values live in Vercel (web/API), Railway (worker) and GitHub
#     Actions secrets — see docs/deployment.md.
#   • The schema is in packages/env/src/schema.ts; keep both in sync
#     (a test fails if they drift).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core platform ────────────────────────────────────────────────────────────
# Public base URL of the web app + API (Vercel URL in production).
APP_URL=http://localhost:3000
# Postgres. Local: docker compose (infra/docker-compose.yml). Production: Neon pooled URL.
DATABASE_URL=postgres://dcard:dcard@localhost:55432/dcard
# Neon direct (non-pooled) URL for migrations. Leave empty locally.
DATABASE_URL_UNPOOLED=
# Redis for BullMQ queues. Local: docker compose. Production: Railway/Redis Cloud.
REDIS_URL=redis://localhost:56379
# firebase = real tokens only (Vercel). dev = local: `fake:<uid>:<email>` test tokens AND real Firebase sign-in. fake = tests only.
AUTH_VERIFIER=dev
# Client API keys: every /api/v1 request must send X-API-Key with one of these (client:key pairs, 32+ chars).
# Generate each with: echo "dk_<client>_$(openssl rand -base64 24 | tr '+/' '-_' | tr -d '=')"
API_KEYS=dummy_replace_with_web:<key>,mobile:<key>,door:<key>,tools:<key>
# The web app's own key (same value as the web: entry above). Visible in the browser: it identifies the client, it is not a secret.
NEXT_PUBLIC_DCARD_API_KEY=dummy_web_key
# 32+ random characters, used to hash card QR/link tokens. Generate: openssl rand -hex 32
TOKEN_HASH_SECRET=dummy_token_hash_secret_replace_with_openssl_rand_hex_32
# Base64-encoded 32-byte key for encrypting Google refresh tokens. Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=dummy_data_encryption_key_replace_with_openssl_rand_base64_32
# Local Docker host ports (defaults avoid clashes with other projects on 5432/6379).
DCARD_PG_PORT=55432
DCARD_REDIS_PORT=56379
# BullMQ key prefix (leave as dcard).
QUEUE_PREFIX=dcard

# ── Firebase (Auth + push notifications) ─────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=dummy_firebase_project_id
FIREBASE_CLIENT_EMAIL=dummy_firebase-adminsdk@project.iam.gserviceaccount.com
# Keep the quotes; newlines as \n.
FIREBASE_PRIVATE_KEY="dummy_-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
# Firebase console → Project settings → General → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=dummy_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dummy_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dummy_firebase_project_id
NEXT_PUBLIC_FIREBASE_APP_ID=dummy_firebase_web_app_id

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
# Meta for Developers → your app → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=dummy_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=dummy_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=dummy_whatsapp_business_account_id
# App settings → Basic → App secret (verifies X-Hub-Signature-256 on webhooks).
WHATSAPP_APP_SECRET=dummy_whatsapp_app_secret
# Any string you choose; paste the same value in the Meta webhook configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dummy_whatsapp_webhook_verify_token
# Graph API version used for calls (check Meta's current version).
WHATSAPP_API_VERSION=v23.0

# ── NextSMS (outbound SMS) ───────────────────────────────────────────────────
NEXTSMS_BASE_URL=https://messaging-service.co.tz
# NextSMS dashboard → API (bearer token).
NEXTSMS_API_TOKEN=dummy_nextsms_api_token
# Registered sender ID shown to recipients.
NEXTSMS_SENDER_ID=DCARD
# Customer Info → Customization → Webhooks → Delivery Callback Verify Token.
NEXTSMS_WEBHOOK_VERIFY_TOKEN=dummy_nextsms_webhook_verify_token

# ── Google Drive (host media storage) ────────────────────────────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web). Enable Drive API.
GOOGLE_OAUTH_CLIENT_ID=dummy_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=dummy_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/media/google/callback

# ── Snippe (host plan payments) ──────────────────────────────────────────────
SNIPPE_BASE_URL=https://api.snippe.sh
# Snippe Dashboard → Settings → API Keys (scopes: collection:read, collection:create).
SNIPPE_API_KEY=dummy_snp_api_key
# Snippe Dashboard → Settings → Webhook Secret (different from the API key).
SNIPPE_WEBHOOK_SECRET=dummy_snippe_webhook_secret

# ── Email (Resend) — team invitation emails ──────────────────────────────────
# resend.com → API Keys. Verify your sending domain (SPF/DKIM) under Domains.
RESEND_API_KEY=dummy_resend_api_key
EMAIL_FROM="D-Card <noreply@dcard.example>"

# ── Integration spikes (local only; used by spikes/*.ts) ─────────────────────
# Your own phone for test SMS/WhatsApp/USSD (255XXXXXXXXX).
SPIKE_TEST_PHONE=dummy_255700000000
# HTTPS tunnel (e.g. cloudflared/ngrok) forwarding to `pnpm spike:webhooks` (port 4040).
SPIKE_PUBLIC_WEBHOOK_BASE_URL=dummy_https://your-tunnel.example.com
# Approved WhatsApp template with two quick-reply buttons (Approve / Decline).
WHATSAPP_TEST_TEMPLATE=dummy_attendance_confirmation_test
WHATSAPP_TEST_TEMPLATE_LANGUAGE=sw
# Refresh token for a test Google account with drive.file scope (OAuth Playground works).
GOOGLE_TEST_REFRESH_TOKEN=dummy_google_test_refresh_token
