{
  "name": "@dcard/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./phone": {
      "types": "./dist/phone/phone.d.ts",
      "default": "./dist/phone/phone.js"
    },
    "./sms": {
      "types": "./dist/messaging/client.d.ts",
      "default": "./dist/messaging/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@dcard/db": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "papaparse": "^5.7.0",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "write-excel-file": "^4.1.1"
  }
}
