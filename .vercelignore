# CLI deploys upload from the repo root (web root directory = apps/web).
# Never upload local secrets: next.config.ts would load a root .env on the build machine.
.env
.env.*
!.env.example
**/.env.local

# Build output and caches
node_modules
**/node_modules
.turbo
**/.turbo
**/.next
**/dist
**/.dart_tool
**/build
coverage

# Not part of the web build
apps/mobile
apps/door
dart_packages
.agents
.claude
