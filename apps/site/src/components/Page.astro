---
import { content, type Lang } from "../i18n/content";
import { localPhone, site } from "../config";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const other = lang === "sw" ? "/en/" : "/";
const signup = site.appUrl ? `${site.appUrl}/signup` : "#contact";
const samples = ["wedding", "send_off", "kitchen_party", "graduation"] as const;
const waText = encodeURIComponent(lang === "sw" ? "Habari D-Card, nina tukio linakuja." : "Hello D-Card, I have an event coming up.");
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2">
    {lang === "sw" ? "Ruka hadi maudhui" : "Skip to content"}
  </a>

  <header class="sticky top-0 z-40 border-b border-brand-100/70 bg-white/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
      <a href={lang === "sw" ? "/" : "/en/"} class="flex items-center gap-2 text-lg font-bold text-brand-700" aria-label="D-Card">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 text-sm font-black text-white">D</span>
        D-Card
      </a>
      <nav aria-label={lang === "sw" ? "Kuu" : "Main"} class="hidden items-center gap-6 text-sm font-medium text-gray-700 md:flex">
        <a href="#how" class="hover:text-brand-600">{t.nav.how}</a>
        <a href="#features" class="hover:text-brand-600">{t.nav.features}</a>
        <a href="#pricing" class="hover:text-brand-600">{t.nav.pricing}</a>
        <a href="#faq" class="hover:text-brand-600">{t.nav.faq}</a>
      </nav>
      <div class="flex items-center gap-3">
        <a href={other} hreflang={lang === "sw" ? "en" : "sw"} class="text-sm font-medium text-gray-600 hover:text-brand-600">{t.nav.switchTo}</a>
        <a href={signup} class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">{t.nav.cta}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 md:grid-cols-2 md:py-20">
        <div>
          <p class="text-sm font-semibold tracking-wide text-brand-600">{t.hero.kicker}</p>
          <h1 class="mt-3 text-4xl leading-tight font-extrabold tracking-tight text-gray-900 md:text-5xl">{t.hero.title}</h1>
          <p class="mt-5 max-w-xl text-lg text-gray-700">{t.hero.body}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={signup} class="rounded-xl bg-brand-600 px-6 py-3 text-base font-semibold text-white shadow hover:bg-brand-700">{t.hero.cta}</a>
            <a href="#pricing" class="rounded-xl bg-white px-6 py-3 text-base font-semibold text-brand-700 ring-1 ring-brand-100 hover:bg-brand-50">{t.hero.secondary}</a>
          </div>
          <ul class="mt-8 grid gap-2 text-sm text-gray-700 sm:grid-cols-3">
            {t.hero.points.map((p) => (
              <li class="flex items-start gap-2">
                <span aria-hidden="true" class="mt-0.5 text-gold-500">●</span>
                {p}
              </li>
            ))}
          </ul>
        </div>
        <div class="flex justify-center md:justify-end">
          <div class="w-64 rounded-[2.2rem] bg-gray-900 p-2.5 shadow-2xl md:w-72">
            <img
              src="/samples/wedding.jpg"
              width="540"
              height="675"
              alt={t.samples.alt(t.samples.types.wedding!)}
              class="rounded-[1.7rem]"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16">
      <h2 class="text-3xl font-bold tracking-tight">{t.how.title}</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        {t.how.steps.map((s) => (
          <li class="rounded-2xl bg-brand-50/60 p-6 ring-1 ring-brand-100">
            <h3 class="text-lg font-semibold text-brand-700">{s.title}</h3>
            <p class="mt-2 text-gray-700">{s.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Features -->
    <section id="features" class="scroll-mt-20 bg-gray-50">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <h2 class="text-3xl font-bold tracking-tight">{t.features.title}</h2>
        <p class="mt-2 text-gray-600">{t.features.intro}</p>
        <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {t.features.items.map((f) => (
            <li class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200">
              <h3 class="font-semibold text-gray-900">{f.title}</h3>
              <p class="mt-2 text-sm text-gray-700">{f.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Samples -->
    <section class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-3xl font-bold tracking-tight">{t.samples.title}</h2>
      <p class="mt-2 text-gray-600">{t.samples.body}</p>
      <ul class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
        {samples.map((s) => (
          <li>
            <img
              src={`/samples/${s}.jpg`}
              width="540"
              height="675"
              alt={t.samples.alt(t.samples.types[s]!)}
              loading="lazy"
              decoding="async"
              class="rounded-2xl shadow-md ring-1 ring-gray-200"
            />
            <p class="mt-2 text-center text-sm font-medium text-gray-700">{t.samples.types[s]}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="scroll-mt-20 bg-brand-900 text-white">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <h2 class="text-3xl font-bold tracking-tight">{t.pricing.title}</h2>
        <p class="mt-2 text-brand-100">{t.pricing.intro}</p>
        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {t.pricing.plans.map((p) => (
            <li class:list={["flex flex-col rounded-2xl p-6", p.tag ? "bg-white text-gray-900 ring-4 ring-gold-400" : "bg-white/5 ring-1 ring-white/15"]}>
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-xl font-bold">{p.name}</h3>
                {p.tag && <span class="rounded-full bg-gold-400 px-3 py-1 text-xs font-bold text-brand-900">{p.tag}</span>}
              </div>
              <p class="mt-4">
                <span class="text-sm">Tsh</span> <span class="text-4xl font-extrabold">{p.price}</span>
                <span class:list={["text-sm", p.tag ? "text-gray-600" : "text-brand-100"]}> {t.pricing.perCard}</span>
              </p>
              <p class:list={["mt-2 text-sm", p.tag ? "text-gray-700" : "text-brand-100"]}>{p.lead}</p>
              <ul class="mt-5 flex-1 space-y-2 text-sm">
                {p.items.map((i) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class={p.tag ? "text-brand-600" : "text-gold-400"}>✓</span>
                    {i}
                  </li>
                ))}
              </ul>
              <a
                href={signup}
                class:list={[
                  "mt-6 rounded-xl px-4 py-2.5 text-center text-sm font-semibold",
                  p.tag ? "bg-brand-600 text-white hover:bg-brand-700" : "bg-white text-brand-700 hover:bg-brand-50",
                ]}
              >
                {t.pricing.cta}
              </a>
            </li>
          ))}
        </ul>
        <ul class="mt-8 grid gap-2 text-sm text-brand-100 md:grid-cols-2">
          {t.pricing.rules.map((r) => <li>• {r}</li>)}
        </ul>
      </div>
    </section>

    <!-- FAQ (native details/summary: no JavaScript) -->
    <section id="faq" class="mx-auto max-w-3xl scroll-mt-20 px-4 py-16">
      <h2 class="text-3xl font-bold tracking-tight">{t.faq.title}</h2>
      <div class="mt-8 divide-y divide-gray-200 rounded-2xl ring-1 ring-gray-200">
        {t.faq.items.map((f) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
              {f.q}
              <span aria-hidden="true" class="text-brand-600 transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-700">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="bg-brand-50">
      <div class="mx-auto max-w-6xl px-4 py-16 text-center">
        <h2 class="text-3xl font-bold tracking-tight">{t.contact.title}</h2>
        <p class="mt-2 text-gray-700">{t.contact.body}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          {site.whatsapp && (
            <a href={`https://wa.me/${site.whatsapp}?text=${waText}`} rel="noopener" class="rounded-xl bg-[#1f7a4d] px-6 py-3 font-semibold text-white hover:bg-[#186540]" data-contact="whatsapp">
              {t.contact.whatsapp}
            </a>
          )}
          {site.phone && (
            <a href={`tel:+${site.phone}`} class="rounded-xl bg-white px-6 py-3 font-semibold text-brand-700 ring-1 ring-brand-100" data-contact="phone">
              {t.contact.call} · {localPhone(site.phone)}
            </a>
          )}
          {site.email && (
            <a href={`mailto:${site.email}`} class="rounded-xl bg-white px-6 py-3 font-semibold text-brand-700 ring-1 ring-brand-100" data-contact="email">
              {t.contact.email}
            </a>
          )}
          {site.appUrl && <a href={signup} class="rounded-xl bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700">{t.contact.start}</a>}
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-gray-200">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm text-gray-600 md:flex-row md:items-center md:justify-between">
      <p><strong class="text-brand-700">D-Card</strong> — {t.footer.tagline}</p>
      <p>© {new Date().getFullYear()} D-Card. {t.footer.rights}</p>
    </div>
  </footer>
</Base>
